# Zero Trust Secrets - DO NOT COMMIT THE ACTUAL .env FILE
# Copy this to .env and fill in the actual values

# -----------------
# API & Application
# -----------------
ENV=development
API_V1_STR=/api/v1
SECRET_KEY=generate_a_secure_key_here_and_do_not_share_it

# -----------------
# Firebase Security
# -----------------
# Path to the service account JSON file for Firebase Admin SDK
FIREBASE_CREDENTIALS_PATH=service-account.json
# Secure Firebase Rules / Auth tokens
FIREBASE_API_KEY=your_firebase_api_key_here


# -----------------
# Rate Limiting & AI
# -----------------
REDIS_URL=redis://localhost:6379/0
AI_MODEL_API_KEY=your_gemini_or_openai_key_here
AI_RATE_LIMIT_PER_MIN=10

# -----------------
# Secure Logging
# -----------------
LOG_LEVEL=INFO
LOG_FILE_PATH=secure_logs/app.log
